# cp terraform.tfvars.example terraform.tfvars
region        = "ap-northeast-2"
cluster_name  = "mlops"
allowed_cidrs = ["180.224.237.157/32"]
owner         = "sejkim" # 모든 AWS 자원의 Owner 태그 (필수)

# 일반 노드 2대(관리형, 온디맨드). 플랫폼 파드가 Pending이면 cpu_node_count = 3 또는 cpu_instance_type = "m6i.2xlarge".
cpu_instance_type = "m6i.xlarge"
cpu_node_count    = 2

# GPU 노드는 Karpenter가 학습 때만 띄운다 (Spot 우선, 없으면 온디맨드). 학습이 끝나고 5분 뒤 0대로 돌아간다.
enable_karpenter      = true
gpu_capacity_types    = ["spot", "on-demand"] # Spot만 쓰려면 ["spot"]
gpu_instance_families = ["g6", "g5", "g4dn"]  # L4 / A10G / T4 — 여러 계열을 허용할수록 Spot을 구하기 쉽다
gpu_node_limit        = 1                     # 동시에 띄울 GPU 개수 상한
burst_cpu_limit       = 8                     # 파이프라인용 임시 CPU 노드의 vCPU 상한 (0이면 끔)

# enable_karpenter = false로 두면 예전처럼 관리형 GPU 노드그룹(온디맨드, 항상 켜짐)을 쓴다.
gpu_instance_type = "g6.xlarge"
gpu_node_count    = 1
