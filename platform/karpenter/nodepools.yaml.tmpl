# Karpenter 노드 설정 (make infra가 platform/karpenter/apply.sh로 적용)
#
#  EC2NodeClass default : "어떤 모양의 EC2를 띄울지" — AMI, 서브넷, 보안 그룹, 태그, 디스크
#  NodePool gpu         : GPU 학습용. Spot 우선, GPU 파드가 없으면 노드 0대
---
apiVersion: karpenter.k8s.aws/v1
kind: EC2NodeClass
metadata:
  name: default
spec:
  role: ${KARPENTER_NODE_ROLE}
  # GPU 인스턴스에는 NVIDIA 드라이버가 든 AL2023 AMI가 자동으로 선택된다.
  amiSelectorTerms:
    - alias: al2023@latest
  subnetSelectorTerms:
    - tags:
        karpenter.sh/discovery: ${CLUSTER_NAME}
  securityGroupSelectorTerms:
    - tags:
        karpenter.sh/discovery: ${CLUSTER_NAME}
  # Karpenter가 만드는 EC2 인스턴스 · EBS · ENI에 붙는 태그 (Owner 필수)
  tags:
    Owner: ${OWNER}
    Project: ${CLUSTER_NAME}
    ManagedBy: karpenter
  blockDeviceMappings:
    - deviceName: /dev/xvda
      ebs:
        volumeSize: 100Gi
        volumeType: gp3
        encrypted: true
        deleteOnTermination: true
---
apiVersion: karpenter.sh/v1
kind: NodePool
metadata:
  name: gpu
spec:
  template:
    metadata:
      labels:
        node-role: gpu            # 학습 파드의 nodeSelector, NVIDIA device plugin의 nodeSelector
    spec:
      nodeClassRef:
        group: karpenter.k8s.aws
        kind: EC2NodeClass
        name: default
      # GPU를 요청하는 파드만 올라오게 한다. taint가 없으면 플랫폼 파드가 올라와 노드가 비지 않는다.
      taints:
        - key: nvidia.com/gpu
          value: "true"
          effect: NoSchedule
      requirements:
        - key: karpenter.sh/capacity-type
          operator: In
          values: ${GPU_CAPACITY_TYPES}
        - key: karpenter.k8s.aws/instance-family
          operator: In
          values: ${GPU_FAMILIES}
        - key: karpenter.k8s.aws/instance-size
          operator: In
          values: ["xlarge", "2xlarge"]
        - key: kubernetes.io/arch
          operator: In
          values: ["amd64"]
        - key: kubernetes.io/os
          operator: In
          values: ["linux"]
      expireAfter: 720h
  # 동시에 띄울 수 있는 GPU 개수 상한
  limits:
    nvidia.com/gpu: ${GPU_LIMIT}
  # GPU 파드가 모두 끝나고 5분이 지나면 노드를 지운다 (연달아 실행할 때 노드를 다시 띄우지 않도록 잠깐 기다림).
  disruption:
    consolidationPolicy: WhenEmpty
    consolidateAfter: 5m
