# cp .env.example .env  후 값을 바꾼다. (.env는 git에 올리지 않는다)

# Kubeflow(Dex) 로그인 비밀번호 — 사용자: user@example.com
KF_USER_PASSWORD=change-me-please

# 버전 (계획서 2절)
KF_VERSION=26.10.0
MLFLOW_VERSION=3.17.2
POSTGRES_IMAGE=postgres:17.11
BUILDKIT_IMAGE=moby/buildkit:v0.34.1-rootless

# 파이프라인 컴포넌트 이미지 태그
IMAGE_TAG=0.1.0

# 6주차 LLM RAG (기본값은 scripts/env.sh, PLAN.md 10.2)
# RAG_IMAGE_TAG=0.1.0
# LLM_MODEL=Qwen/Qwen3-8B-FP8
# EMBED_MODEL=BAAI/bge-m3
# VLLM_IMAGE=vllm/vllm-openai:v0.33.0
# AWSCLI_IMAGE=amazon/aws-cli:2.40.1
# RAGDB_IMAGE=pgvector/pgvector:0.8.6-pg17
